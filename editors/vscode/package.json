{
  "name": "starkite",
  "displayName": "Starkite",
  "description": "Language intelligence, static diagnostics, and execution support for Starkite automation scripts.",
  "version": "0.11.6",
  "publisher": "project-starkite",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-starkite/starkite.git",
    "directory": "editors/vscode"
  },
  "keywords": [
    "starkite",
    "starlark",
    "automation",
    "language-server",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package --skip-license"
  },
  "activationEvents": [
    "onLanguage:starkite",
    "onLanguage:starlark"
  ],
  "contributes": {
    "languages": [
      {
        "id": "starkite",
        "aliases": [
          "Starkite",
          "starlark"
        ],
        "extensions": [
          ".star"
        ],
        "firstLine": "^#!.*\\bkite\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "starkite.restartServer",
        "title": "Starkite: Restart Language Server",
        "category": "Starkite"
      },
      {
        "command": "starkite.validateFile",
        "title": "Starkite: Validate Script (with Lints)",
        "category": "Starkite"
      },
      {
        "command": "starkite.runFile",
        "title": "Starkite: Run Current Script in Sandbox",
        "category": "Starkite"
      },
      {
        "command": "starkite.showDocs",
        "title": "Starkite: Show Documentation for Symbol",
        "category": "Starkite"
      }
    ],

    "menus": {
      "editor/title": [
        {
          "command": "starkite.runFile",
          "when": "editorLangId == starkite",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "starkite.validateFile",
          "when": "editorLangId == starkite",
          "group": "starkite"
        },
        {
          "command": "starkite.runFile",
          "when": "editorLangId == starkite",
          "group": "starkite"
        }
      ]
    },
    "configuration": {
      "title": "Starkite",
      "properties": {
        "starkite.serverPath": {
          "type": "string",
          "default": "kite",
          "description": "Path to the Starkite binary (defaults to 'kite')."
        },
        "starkite.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log traffic between editor and language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
